# Entity: year

main: kit: entity: year: {

  alias: field: {}

  fields: [
    {
      name: "sponsored_by"
      req: true
      short: "Sponsored message (required to be displayed/logged per Terms of Service for free tier users)"
      type: "`$STRING`"
    }
    {
      name: "year"
      req: true
      short: "The current year as an integer"
      type: "`$INTEGER`"
    }
    {
      name: "year_string"
      req: true
      short: "The current year as a string"
      type: "`$STRING`"
    }
  ]

  name: "year"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/year"
          segments: [
            {
              lit: "year"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
